{
    "name": "dotnet-test-rerun devcontainer",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "containerEnv": {
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "ZSH_DOTENV_PROMPT": "false"
    },
    "features": {
        "ghcr.io/devcontainers/features/dotnet": {
            "version": "10.0",
            "additionalVersions": "8.0"
        },
        "ghcr.io/devcontainers/features/github-cli": {},
        "ghcr.io/devcontainers/features/docker-in-docker": {
            "moby": false
        },
        "ghcr.io/nils-geistmann/devcontainers-features/zsh": {
            "theme": "agnoster",
            "plugins": "git docker dotnet dotenv"            
        },
        "ghcr.io/stuartleeks/dev-container-features/shell-history": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "formulahendry.docker-explorer",
                "ms-azuretools.vscode-docker",
                "ms-dotnettools.csdevkit",
                "FullStackSpider.visual-nuget",
                "actboy168.tasks",
                "esbenp.prettier-vscode",
                "github.vscode-github-actions",
                "GitHub.copilot"
            ]
        }
    },
    "postCreateCommand": 
    {
        "build": "dotnet tool restore && dotnet build",
        "alias": "echo \"alias 'test-rerun=/workspaces/dotnet-test-rerun/src/bin/Debug/net10.0/test-rerun'\" >> /home/$USER/.bashrc "
    }
}